{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlashBee",
  "version": "0.2.0",
  "identifier": "com.flashbee.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlashBee",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "visible": false,
        "acceptFirstMouse": true,
        "zoomHotkeysEnabled": false,
        "disableInputAccessoryView": true,
        "allowLinkPreview": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 30
        },
        "backgroundColor": "#080a0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:5173 http://127.0.0.1:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A calm, native multi-repository Git viewer.",
    "longDescription": "FlashBee is a native macOS app for reviewing changes across multiple local Git repositories. It reads repositories from disk, never uploads them, and follows your system appearance.",
    "copyright": "MIT © 2026 wangzhuo",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
